## You can whitelist files/folders with !, these will not be ignored.
!*.yaml
!.gitignore
!*.md

## logs
*.log
*.log.*

## Ignore folders.
.storage
.cloud
.google.token
.config

## Ensure these YAML files are ignored, otherwise your secret data/credentials will leak.
ip_bans.yaml
known_devices.yaml
secrets.yaml

## HA-managed runtime state (drifts from repo, breaks git-sync on the pod)
.HA_VERSION

## Others
._includes
.homekit.state
.spotify-token-cache
.vscode/
home-assistant_v2.db
home-assistant_v2.db-shm
home-assistant_v2.db-wal
lost+found
